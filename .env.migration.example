# Copier en .env.migration, remplir, puis lancer ./scripts/migration/tout-migrer.sh
# Ancien Supabase (ton serveur)
ANCIENNE_DB_URL=postgresql://postgres.TENANT:MOTDEPASSE@localhost:5432/postgres
ANCIEN_SUPABASE_URL=https://ton-supabase.exemple.com
ANCIENNE_SERVICE_KEY=
# Nouveau Supabase (projet du client) - bouton "Connect", chaîne "Session pooler"
NOUVELLE_DB_URL=postgresql://postgres.REF:MOTDEPASSE@aws-0-REGION.pooler.supabase.com:5432/postgres
NOUVEAU_SUPABASE_URL=https://REF.supabase.co
NOUVELLE_SERVICE_KEY=
